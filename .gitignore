# Exclude sensitive configuration files
parameters.json
keys.txt

# Exclude large media files
*.mp4
sample media/

# Graphics templates contain embedded station logos — keep directory, ignore content
graphics/templates/*.json
graphics/README.md

# Exclude reference API specs (third-party, not our code)
reference/

# Exclude generated security scan reports
ash-security-report.html
cdk-nag-results.txt

